<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+: para ver si WhatsApp está instalado y consultar su whitelist (D7: solo WhatsApp común). -->
    <queries>
        <package android:name="com.whatsapp" />
    </queries>

    <!-- Spec 007, D2: internet solo para bajar videos de links de X. ML Kit trae datatransport, que manda
         métricas de uso a Google: se le quita el componente que las sube (TransportBackendDiscovery, abajo).
         ACCESS_NETWORK_STATE sigue quitado (spec 002, D13). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- D12: sin backup por ahora. En Android 11 alcanza con allowBackup="false" (no hace falta
         fullBackupContent); en 12+ las reglas de extracción excluyen también la transferencia entre equipos. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Spec 002, D7: Play services baja el modelo de quitar fondo al instalar la app. -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Spec 006: aparece en "Compartir" con fotos, videos y GIF (D1, D4). Sin texto, así no aparece con links (D5). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Spec 007, D2: sin este servicio, datatransport no encuentra cómo subir las métricas de ML Kit. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:node="remove" />

        <!-- Contrato de WhatsApp (spec 001, secciones 8 y 10): exportado, solo lectura con el permiso de WhatsApp. -->
        <provider
            android:name=".provider.StickerContentProvider"
            android:authorities="${applicationId}.stickercontentprovider"
            android:enabled="true"
            android:exported="true"
            android:readPermission="com.whatsapp.sticker.READ" />
    </application>
</manifest>
